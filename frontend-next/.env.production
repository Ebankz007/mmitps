# Backend API base URL (Express server)
# In production, this should point to the public domain where the API is hosted.
NEXT_PUBLIC_API_URL=https://api.mmitps.com

# WebSocket URL (Socket.IO)
NEXT_PUBLIC_WS_URL=https://api.mmitps.com

# Python AI Engine URLs
NEXT_PUBLIC_AI_URL=https://ai.mmitps.com

# JWT key name (must match backend)
NEXT_PUBLIC_TOKEN_KEY=mmitps_token
NEXT_PUBLIC_USER_KEY=mmitps_user

# Auth.js / NextAuth.js
# NEXTAUTH_URL must be the full public URL of the frontend
# AUTH_SECRET must be a unique, cryptographically strong string
NEXTAUTH_URL=https://mmitps.com
AUTH_SECRET=REPLACE_WITH_STRONG_SECRET_IN_PRODUCTION
