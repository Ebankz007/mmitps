# MMITPS Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=5066
NODE_ENV=development
# Options: development, staging, production

# ===========================================
# DATABASE
# ===========================================
# MongoDB removed â€” migration to PostgreSQL complete (2026-09-13).
# MONGODB_URI=mongodb://127.0.0.1:27017/mmitps

# PostgreSQL (Drizzle ORM) â€” primary store
DATABASE_URL=postgresql://user:password@localhost:5433/mmitps_dev
# Encryption key for sensitive fields (TradingAccount passwords, CryptoWallet private keys, KYC docs)
# 32 bytes hex â€” generate with: openssl rand -hex 32
ENCRYPTION_KEY=change-me-64-hex

REDIS_URL=redis://localhost:6379
# Optional: Used for caching and session storage

# ===========================================
# JWT AUTHENTICATION
# ===========================================
JWT_SECRET=change-me-88-char-base64
JWT_REFRESH_SECRET=change-me-88-char-base64
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ACCESS_EXPIRATION_MINUTES=1440

# ===========================================
# PAYMENT GATEWAYS
# ===========================================

# PayStack (Nigeria, Ghana, Kenya, South Africa)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Flutterwave (30+ African countries + Global)
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_ENCRYPTION_KEY=change-me-64-hex
FLUTTERWAVE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Korapay (Nigeria, Kenya, Ghana)
KORAPAY_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KORAPAY_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KORAPAY_ENCRYPTION_KEY=change-me-64-hex

# ===========================================
# CRYPTOCURRENCY
# ===========================================

# Bitcoin
CRYPTO_WALLET_BTC=bc1qxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BTC_CONFIRMATION_BLOCKS=3

# Ethereum
CRYPTO_WALLET_ETH=0xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxXx
ETH_CONFIRMATION_BLOCKS=12

# USDT (Multiple Networks)
CRYPTO_WALLET_USDT_ERC20=0xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxXx
CRYPTO_WALLET_USDT_TRC20=Txxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CRYPTO_WALLET_USDT_BEP20=0xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxXx

# USDC
CRYPTO_WALLET_USDC_ERC20=0xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxXx

# Solana
CRYPTO_WALLET_SOL=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Blockchain API (for transaction verification)
BLOCKCYPHER_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ETHERSCAN_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# EMAIL / SMTP
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# For production, consider:
# - SendGrid: SENDGRID_API_KEY
# - Mailgun: MAILGUN_API_KEY, MAILGUN_DOMAIN
# - AWS SES: AWS_SES_ACCESS_KEY, AWS_SES_SECRET_KEY

EMAIL_FROM_NAME=MMITPS
EMAIL_FROM_ADDRESS=noreply@mmitps.com

# ===========================================
# EXTERNAL APIs - MARKET DATA
# ===========================================

# Trading Economics (Economic Indicators)
TRADING_ECONOMICS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Alpha Vantage (Stock/Forex Data)
ALPHA_VANTAGE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twelve Data (Real-time Quotes)
TWELVE_DATA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# CoinMarketCap (Crypto Prices)
COINMARKETCAP_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# CoinGecko (Alternative Crypto API)
COINGECKO_API_KEY=CG-xxxxxxxxxxxxxxxxxxxxxxxx

# News API (Economic Calendar)
NEWS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# FUTURES CONTRACTS DATA
# ===========================================
# Barchart OnDemand - FREE tier available: https://www.barchart.com/ondemand
# Used for live futures contract specs (tick size, margin, expiry, liquidity)
# Endpoints: getFuturesSpecifications, getFuturesContracts, getQuote
BARCHART_API_KEY=

# ===========================================
# TRADING PLATFORM INTEGRATIONS
# ===========================================

# MetaTrader Manager API
MT4_MANAGER_HOST=your-mt4-server.com
MT4_MANAGER_PORT=443
MT4_MANAGER_LOGIN=your-manager-login
MT4_MANAGER_PASSWORD=your-manager-password

MT5_MANAGER_HOST=your-mt5-server.com
MT5_MANAGER_PORT=443
MT5_MANAGER_LOGIN=your-manager-login
MT5_MANAGER_PASSWORD=your-manager-password

# ===========================================
# FILE STORAGE
# ===========================================

# AWS S3 (for file uploads)
AWS_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_S3_BUCKET=mmitps-uploads
AWS_REGION=us-east-1

# Alternative: Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=xxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# SECURITY
# ===========================================

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Session
SESSION_SECRET=change-me-88-char-base64
SESSION_MAX_AGE=86400000

# CORS
CORS_ORIGIN=http://localhost:3001,http://localhost:3000,https://yourdomain.com

# ===========================================
# MONITORING & LOGGING
# ===========================================

# Sentry (Error Tracking)
SENTRY_DSN=https://xxxxxxxx@xxxxx.ingest.sentry.io/xxxxxxx

# LogRocket (Session Replay)
LOGROCKET_APP_ID=xxxxxx/mmitps

# Google Analytics
GA_TRACKING_ID=UA-XXXXXXXXX-X

# ===========================================
# FEATURE FLAGS
# ===========================================
ENABLE_TOKENIZATION=true
ENABLE_COPY_TRADING=true
ENABLE_MLM=true
ENABLE_CRYPTO_PAYMENTS=true
ENABLE_2FA=true
ENABLE_KYC=true

# Geo-restrictions (comma-separated country codes to block)
BLOCKED_COUNTRIES=US,IR,KP,CU,SY

# ===========================================
# MISC
# ===========================================

# Admin credentials (change in production!)
ADMIN_EMAIL=admin@mmitps.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_IN_PRODUCTION

# Platform settings
PLATFORM_NAME=MMITPS
PLATFORM_URL=https://yourdomain.com
SUPPORT_EMAIL=support@mmitps.com

# MLM Settings
MLM_BINARY_MATCH_PERCENTAGE=10
MLM_DIRECT_REFERRAL_PERCENTAGE=10
MLM_LEVEL_BONUS_PERCENTAGES=5,3,2,1,1

# Subscription Settings
FREE_TRIAL_DAYS=7
