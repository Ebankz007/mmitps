# Server Configuration
PORT=5055
NODE_ENV=production

# Database
# Production MongoDB URI (e.g. Atlas)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/mmitps?retryWrites=true&w=majority

# Security
# MUST be a long random string (≥32 chars)
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_IN_PRODUCTION
JWT_EXPIRE=30d
COOKIE_EXPIRE=30

# CORS & Frontend Origins
# Only allow production domains
ALLOWED_ORIGIN=https://mmitps.com

# SMTP / Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=mmitpsinc@gmail.com
SMTP_PASS=REPLACE_WITH_APP_PASSWORD_IN_PRODUCTION
FROM_EMAIL=mmitpsinc@gmail.com
FROM_NAME=MMITPS Intelligence

# 2FA / Speakeasy
2FA_ISSUER=MMITPS
